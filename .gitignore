# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Local environment / secrets
.env
.env.*
*.local

# Data (never committed by default; projects installed via ds_init keep
# their own data/ and notebooks/ out of version control unless they choose
# otherwise)
data/
*.parquet
*.csv.gz

# ds_init temporary staging left behind by an interrupted run
.ds_init_staging_*/
